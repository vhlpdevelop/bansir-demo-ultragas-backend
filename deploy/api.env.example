DATABASE_URL=postgresql://bansir_api:REPLACE@host.docker.internal:5432/bansir
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=1
FISCAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
FISCAL_PRODUCTION_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WhatsApp Business Platform: values from the SaaS Meta app, never from a customer token.
META_APP_ID=1793938688602287
# Public configuration ID from WhatsApp Embedded Signup (different from the App ID).
META_EMBEDDED_SIGNUP_CONFIG_ID=1017617441354422
# Use the Graph API version enabled in the Meta app dashboard.
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
META_VERIFY_TOKEN=

# Embedded Signup flow selected in Meta (distinct from Graph API version).
META_EMBEDDED_SIGNUP_FEATURE_TYPE=whatsapp_business_app_onboarding

AWS_REGION=sa-east-1
META_CONNECT_FUNCTION_ARN=arn:aws:lambda:sa-east-1:783764583281:function:bansir-meta-prod-connect-gas-1
META_EMBEDDED_SIGNUP_ENABLED=false
