DATABASE_URL=postgresql://bansir_api:REPLACE@host.docker.internal:5432/bansir
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=1
FISCAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
FISCAL_PRODUCTION_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WhatsApp Business Platform: values from the SaaS Meta app, never from a customer token.
META_APP_SECRET=
META_VERIFY_TOKEN=
