VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bansir.com

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bansir_saas?retryWrites=true&w=majority

# Migração por etapas: postgres ativa exclusivamente as rotas já migradas.
# A demo antiga continua usando mongodb até o corte deliberado.
DATABASE_ENGINE=postgres
# Runtime: login membro de bansir_runtime; não pode ser dono/superuser/BYPASSRLS.
DATABASE_URL=postgresql://bansir_app:CHANGE_ME@127.0.0.1:5432/bansir
# Somente no processo administrativo de migração/provisionamento, nunca na API EC2.
DATABASE_ADMIN_URL=
POSTGRES_JWT_EXPIRES_IN=1h
TRUST_PROXY_HOPS=0
BOOTSTRAP_TENANT_SLUG=ultragas
BOOTSTRAP_TENANT_NAME=Ultragas
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_PLAN_CODE=migration-single
# Administração de planos/unidades: definir com valores contratados, fora da API.
MANAGE_TENANT_SLUG=
MANAGE_PLAN_CODE=
MANAGE_PLAN_NAME=
MANAGE_PLAN_MAX_ESTABLISHMENTS=
MANAGE_ESTABLISHMENT_NAME=
MANAGE_ESTABLISHMENT_DOCUMENT=
# Array JSON: [{"userId":"UUID","role":"operador","allowedRoutes":["sales"]}]
MANAGE_ESTABLISHMENT_MEMBERSHIPS=
MIGRATION_TENANT_SLUG=ultragas
MIGRATION_TENANT_NAME=Ultragas

# Seed inicial: defina senhas únicas de pelo menos 12 caracteres.
SEED_ADMIN_EMAIL=caroline@bansir.com.br
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_OPERATOR_PASSWORD=

# Obrigatória para assinar sessões. Use uma chave aleatória longa.
JWT_SECRET=

# Segurança & CORS
# Exemplo: https://bansir-demo.netlify.app,http://localhost:5173 (ou deixe vazio para permitir dev/localhost)
CORS_ORIGIN=
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT_GENERAL=500kb
BODY_LIMIT_XML=15mb

# Pagamento + fiscal. Produção está bloqueada até homologação da loja.
# demo: simulação local persistida; homologation: Cielo Sandbox + SEFAZ tpAmb=2.
INTEGRATION_MODE=demo
CIELO_CLIENT_ID=
CIELO_ACCESS_TOKEN=
CIELO_MERCHANT_ID=
# Render Secret File: nunca colocar certificado ou senha no frontend/Git.
FISCAL_CERT_PATH=/etc/secrets/certificado.pfx
FISCAL_CERT_PASSWORD=
FISCAL_CNPJ=
FISCAL_CSC_ID=
FISCAL_CSC_TOKEN=
# Use série exclusiva de homologação; sequência persistida por CNPJ/modelo/série.
FISCAL_SERIES=1

# Novo módulo PostgreSQL: configurações e certificado de cada estabelecimento ficam no banco.
# Os FISCAL_CERT_PATH/CNPJ/CSC acima pertencem somente ao legado Mongo/homologação.
WORKER_DATABASE_URL=
FISCAL_ENCRYPTION_KEY=
FISCAL_PRODUCTION_ENABLED=false
AWS_REGION=sa-east-1
FISCAL_S3_BUCKET=
FISCAL_S3_KMS_KEY_ID=
