VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bansir.com


# Backend exclusivamente PostgreSQL; MongoDB foi aposentado.
DATABASE_ENGINE=postgres
# Runtime: login membro de bansir_runtime; não pode ser dono/superuser/BYPASSRLS.
DATABASE_URL=postgresql://bansir_app:CHANGE_ME@127.0.0.1:5432/bansir
# Somente no processo administrativo de migração/provisionamento, nunca na API EC2.
DATABASE_ADMIN_URL=
POSTGRES_JWT_EXPIRES_IN=1h
TRUST_PROXY_HOPS=0
BOOTSTRAP_TENANT_SLUG=ultragas
BOOTSTRAP_TENANT_NAME=Ultragas
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_PLAN_CODE=migration-single
# Administração de planos/unidades: definir com valores contratados, fora da API.
MANAGE_TENANT_SLUG=
MANAGE_PLAN_CODE=
MANAGE_PLAN_NAME=
MANAGE_PLAN_MAX_ESTABLISHMENTS=
MANAGE_ESTABLISHMENT_NAME=
MANAGE_ESTABLISHMENT_DOCUMENT=
# Array JSON: [{"userId":"UUID","role":"operador","allowedRoutes":["sales"]}]
MANAGE_ESTABLISHMENT_MEMBERSHIPS=

# Obrigatória para assinar sessões. Use uma chave aleatória longa.
JWT_SECRET=

# Segurança & CORS
# Exemplo: https://bansir-demo.netlify.app,http://localhost:5173 (ou deixe vazio para permitir dev/localhost)
CORS_ORIGIN=
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT_GENERAL=500kb
BODY_LIMIT_XML=15mb

# Configurações e certificados fiscais são específicos de cada estabelecimento.
WORKER_DATABASE_URL=
FISCAL_ENCRYPTION_KEY=
FISCAL_PRODUCTION_ENABLED=false
AWS_REGION=sa-east-1
FISCAL_S3_BUCKET=
FISCAL_S3_KMS_KEY_ID=
